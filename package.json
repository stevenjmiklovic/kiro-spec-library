{
  "name": "kiro-spec-library",
  "version": "0.2.1",
  "description": "Index, browse, and curate Kiro Specs across repositories with relationship mapping and AI-assisted metadata.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Johns Hopkins University Sheridan Libraries",
  "repository": {
    "type": "git",
    "url": "https://github.com/stevenjmiklovic/kiro-spec-library.git"
  },
  "homepage": "https://github.com/stevenjmiklovic/kiro-spec-library#readme",
  "keywords": [
    "kiro",
    "specs",
    "specification",
    "library",
    "graph",
    "relationship",
    "developer-tools",
    "mcp",
    "kirocrew"
  ],
  "bin": {
    "kiro-spec-library": "./bin/cli.ts"
  },
  "files": [
    "bin/cli.ts",
    "backend/dist/index.mjs",
    "shared/dist/index.mjs",
    "ui/preview.html",
    "ui/preview.js",
    "ui/preview.css",
    "app.json",
    "agents/",
    "scripts/start-backend.sh",
    "assets/icon-256.png",
    "assets/favicon.ico",
    "mcp/src/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "os": ["darwin", "linux"],
  "workspaces": ["shared", "backend", "ui", "mcp"],
  "scripts": {
    "build": "bun run --filter '*' build",
    "typecheck": "tsc --build",
    "test": "bun test",
    "test:sites": "node --test poc/tests/sites-worker.test.mjs",
    "start": "./scripts/start-backend.sh",
    "dev": "bun run --filter backend dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepublishOnly": "bun run build",
    "changelog:draft": "bun run scripts/changelog.ts draft",
    "changelog:compile": "bun run scripts/changelog.ts compile"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@happy-dom/global-registrator": "15.11.7",
    "@playwright/test": "1.49.1",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.1.0",
    "@types/bun": "1.2.14",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "fast-check": "3.22.0",
    "fflate": "^0.8.3",
    "happy-dom": "15.11.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "typescript": "5.6.3"
  }
}
